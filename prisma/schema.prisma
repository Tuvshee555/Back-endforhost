generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  password         String?
  phonenumber      String?
  address          String?
  role             Role        @default(USER)
  isVerified       Boolean     @default(false)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  city             String?
  district         String?
  firstName        String?
  khoroo           String?
  lastName         String?
  notes            String?
  FoodOrder        FoodOrder[]
  orderedFoods     OrderItem[]
  cartItems        CartItem[]
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String        @unique
  orderId   String        @unique
  amount    Float
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  qrText    String?
  status    PaymentStatus @default(PENDING)
  qrImage   String?
}

model Food {
  id          String      @id @default(uuid())
  foodName    String
  price       Float
  image       String
  address     String?
  ingredients String
  categoryId  String?
  createdAt   DateTime    @default(now())
  extraImages String[]    @default([])
  updatedAt   DateTime    @default(now()) @updatedAt
  video       String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  sizes       FoodSize[]
  OrderItem   OrderItem[]
  cartItems   CartItem[]
}

model FoodSize {
  id     String @id @default(uuid())
  foodId String
  label  String
  stock  Int?
  food   Food   @relation(fields: [foodId], references: [id])
}

model Category {
  id           String @id @default(uuid())
  categoryName String
  foods        Food[]
}

model FoodOrder {
  id             String      @id @default(uuid())
  userId         String
  totalPrice     Float
  status         OrderStatus @default(PENDING)
  location       String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  user           User        @relation(fields: [userId], references: [id])
  foodOrderItems OrderItem[]
}

model OrderItem {
  id       String    @id @default(uuid())
  foodId   String
  quantity Int
  orderId  String
  userId   String?
  food     Food      @relation(fields: [foodId], references: [id])
  order    FoodOrder @relation(fields: [orderId], references: [id])
  User     User?     @relation(fields: [userId], references: [id])
}

model CartItem {
  id           String   @id @default(uuid())
  userId       String
  foodId       String
  quantity     Int      @default(1)
  selectedSize String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  food Food @relation(fields: [foodId], references: [id])

  @@unique([userId, foodId, selectedSize]) // one cart entry per item+size
}

enum Role {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
}

enum OrderStatus {
  PENDING
  CANCELLED
  DELIVERED
}
